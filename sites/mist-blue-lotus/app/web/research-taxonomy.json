          "name": "记忆与检索增强",
          "pattern": "\\A(?=[\\s\\S]*(?:\\bagents?\\b|agentic))[\\s\\S]*(?:agent.{0,20}memor|long.term memor|episodic memor|retrieval.augmented|\\brag\\b)"
        },
        {
          "id": "detail-8",
          "name": "规划、推理与决策",
