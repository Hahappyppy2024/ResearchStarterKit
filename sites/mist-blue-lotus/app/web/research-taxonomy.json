{
  "version": 1,
  "roots": [
    {
      "id": "interpretability",
      "name": "模型可解释性",
      "label": "模型可解释性 / Model Interpretability",
      "color": "#8d78af",
      "subtopics": [
        {
          "id": "mechanistic",
          "name": "机制可解释性",
          "pattern": "mechanistic.interpret|sparse.autoencoder|activation.patch|causal.trac|neural.circuit|模型机制解释|机制可解释"
        },
        {
          "id": "features",
          "name": "特征与概念解释",
          "pattern": "concept.bottleneck|concept.activation|feature.interpret|feature.visuali[sz]|monosemantic|特征解释|概念解释"
        },
        {
          "id": "attribution",
          "name": "归因与重要性分析",
          "pattern": "feature.attribution|integrated.gradients|gradient.attribution|\\bshap\\b|saliency.map|特征归因|重要性分析"
        },
        {
          "id": "methods",
          "name": "可解释方法与模型",
          "pattern": "explainable.ai|interpretable.model|post.hoc.explan|counterfactual.explan|可解释模型|反事实解释"
        },
        {
          "id": "evaluation",
          "name": "解释忠实性与评测",
          "pattern": "explanation.faithful|faithful.explan|interpretability.benchmark|explanation.evaluation|解释忠实|解释评测"
        },
        {
          "id": "general",
          "name": "模型可解释性综合",
          "pattern": "interpretability|interpretable|explainability|explainable|可解释性"
        }
      ]
    },
    {
