          "pattern": "\\A(?=[\\s\\S]*(?:\\bagents?\\b|agentic))[\\s\\S]*(?:benchmark|evaluation|evaluating|assessment|test suite)"
        },
        {
          "id": "detail-13",
          "name": "智能体学习与优化",
          "pattern": "\\A(?=[\\s\\S]*(?:\\bagents?\\b|agentic))[\\s\\S]*(?:reinforcement learning|self.evol|self.improv|agent training|policy optim|agent optim)"
        },
        {
          "id": "detail-14",
          "name": "运行框架与基础设施",
          "pattern": "\\A(?=[\\s\\S]*(?:\\bagents?\\b|agentic))[\\s\\S]*(?:agent runtime|agent harness|agent operating system|agentos|\\baios\\b|orchestration|agent framework|agent infrastructure)"
        },
        {
          "id": "detail-15",
          "name": "智能体综合",
          "pattern": "\\bagents?\\b|agentic"
        }
      ]
