          "name": "科研与发现智能体",
          "pattern": "\\A(?=[\\s\\S]*(?:\\bagents?\\b|agentic))[\\s\\S]*(?:scientific discovery|research agent|agentic research|science agent|automated research|scientific agent)"
        },
        {
          "id": "detail-10",
          "name": "医疗与健康智能体",
          "pattern": "\\A(?=[\\s\\S]*(?:\\bagents?\\b|agentic))[\\s\\S]*(?:medical|clinical|healthcare|diagnosis|patient)"
        },
        {
          "id": "detail-11",
          "name": "教育与学习智能体",
          "pattern": "\\A(?=[\\s\\S]*(?:\\bagents?\\b|agentic))[\\s\\S]*(?:education|tutoring|student|teaching|pedagog)"
        },
        {
          "id": "detail-12",
